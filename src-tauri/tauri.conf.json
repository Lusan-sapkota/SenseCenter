{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SenseCenter",
  "version": "0.1.0",
  "identifier": "com.sensecenter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SenseCenter",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "lm-sensors"
        ],
        "recommends": [
          "fwupd"
        ]
      },
      "rpm": {
        "depends": [
          "lm_sensors"
        ]
      }
    }
  }
}
